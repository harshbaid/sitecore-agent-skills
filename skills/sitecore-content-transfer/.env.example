# Organization automation client (SitecoreAI Deploy > Credentials > Environment > Automation).
# One org client works for BOTH environments - the CM host in each API call
# decides which environment is hit.
SITECORE_CLIENT_ID=your-client-id
SITECORE_CLIENT_SECRET=your-client-secret

# Only needed when source and target are in DIFFERENT Sitecore organizations:
# SITECORE_SOURCE_CLIENT_ID=
# SITECORE_SOURCE_CLIENT_SECRET=
# SITECORE_TARGET_CLIENT_ID=
# SITECORE_TARGET_CLIENT_SECRET=
