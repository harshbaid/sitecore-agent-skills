# ---------------------------------------------------------------------------
# GraphQL Authoring & Management API - ORGANIZATION automation client.
# One org-scoped client authorizes every CM in the organization; the CM host in
# each call decides which environment is hit. Create it in the XM Cloud Deploy
# portal: org menu > Credentials > Automation client (org-scoped, NOT per-environment).
# These are SECRETS. The real .env is gitignored - never commit real values.
# ---------------------------------------------------------------------------
SC_CLIENT_ID=your-client-id
SC_CLIENT_SECRET=your-client-secret

# OAuth endpoint / audience. Defaults are correct for the Sitecore Cloud "use"
# region; override only if you are told to.
SC_AUTH_URL=https://auth.sitecorecloud.io/oauth/token
SC_AUTH_AUDIENCE=https://api.sitecorecloud.io

# CM host per environment (include https://). The label before _CM_HOST maps to
# the value you type after --env. Add/rename/remove to match your project.
# Find each host in Deploy portal > Project > Environment > Details > host name.
SC_DEV_CM_HOST=https://<your-dev-cm-host>.sitecorecloud.io
SC_UAT_CM_HOST=https://<your-uat-cm-host>.sitecorecloud.io
SC_PROD_CM_HOST=https://<your-prod-cm-host>.sitecorecloud.io

# ---------------------------------------------------------------------------
# Agent API v2.0 (REST) - only needed for the `agent` command.
# This layer REJECTS the org client; it needs a per-ENVIRONMENT automation client.
# Create in Deploy portal > Credentials > Environment > Create credentials > Automation,
# one per environment. Leave blank if you only use the GraphQL commands.
# ---------------------------------------------------------------------------
SC_AGENT_BASE_URL=https://edge-platform.sitecorecloud.io/stream/ai-agent-api
SC_DEV_AGENT_CLIENT_ID=
SC_DEV_AGENT_CLIENT_SECRET=
SC_UAT_AGENT_CLIENT_ID=
SC_UAT_AGENT_CLIENT_SECRET=
SC_PROD_AGENT_CLIENT_ID=
SC_PROD_AGENT_CLIENT_SECRET=
